# SourceCraft OpenAI-compatible API
# POST {SOURCECRAFT_API_URL}/chat/completions with Bearer SOURCECRAFT_API_KEY
SOURCECRAFT_API_URL=https://your-sourcecraft-host/v1
SOURCECRAFT_API_KEY=
# Optional model id
SOURCECRAFT_MODEL=default

# Force deterministic mock replies (no network). Also used automatically
# when URL/key are missing or the API request fails.
LLM_MOCK=1
